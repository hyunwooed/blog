---
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { getLangFromUrl, type Lang, useTranslations } from "@/i18n";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	lang?: Lang;
}

const {
	lang = getLangFromUrl(Astro.url),
	meta: { articleDate, description, ogImage, title },
} = Astro.props;
const t = useTranslations(lang);
const metaDescription = description ?? t.global.description;
---

<html class="scroll-smooth" lang={t.locale}>
	<head>
		<BaseHead
			articleDate={articleDate}
			description={metaDescription}
			ogImage={ogImage}
			title={title}
			lang={lang}
		/>
		<ThemeProvider />
	</head>
	<body class="bg-global-bg text-global-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 pt-16 text-sm font-normal antialiased sm:px-8">
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
