---
import { getEntry, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { defaultLang, nonDefaultLangs } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (() => {
	return nonDefaultLangs.map((lang) => ({
		params: { lang },
		props: { lang },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const aboutEntry = (await getEntry("about", lang)) ?? (await getEntry("about", defaultLang));
if (!aboutEntry) throw new Error(`About entry not found for ${lang}`);

const { Content } = await render(aboutEntry);
---

<PageLayout
	lang={lang}
	meta={{ title: aboutEntry.data.title, description: aboutEntry.data.description }}
>
	<h1 class="title mb-12">{aboutEntry.data.title}</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</PageLayout>
