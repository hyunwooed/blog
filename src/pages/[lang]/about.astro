---
import { getEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import { defaultLang, type Lang, languageCodes } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (() => {
	const nonDefaultLangs = languageCodes.filter((lang) => lang !== defaultLang);
	return nonDefaultLangs.map((lang) => ({
		params: { lang },
		props: { lang },
	}));
}) satisfies GetStaticPaths;

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const aboutEntry = (await getEntry("about", lang)) ?? (await getEntry("about", defaultLang));
if (!aboutEntry) throw new Error(`About entry not found for ${lang}`);

const { Content } = await render(aboutEntry);
---

<PageLayout meta={{ title: aboutEntry.data.title, description: aboutEntry.data.description }}>
	<h1 class="title mb-12">{aboutEntry.data.title}</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</PageLayout>
