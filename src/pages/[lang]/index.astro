---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllNotes, getAllPosts } from "@/data/post";
import { defaultLang, getLocalizedUrl, type Lang, languageCodes, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";
import { MAX_HOME_NOTES, MAX_PINNED_POSTS, POSTS_PER_PAGE } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (() => {
	const nonDefaultLangs = languageCodes.filter((lang) => lang !== defaultLang);
	return nonDefaultLangs.map((lang) => ({
		params: { lang },
		props: { lang },
	}));
}) satisfies GetStaticPaths;

interface Props {
	lang: Lang;
}

const { lang } = Astro.props as Props;
const t = useTranslations(Astro.url);

// Posts
const allPosts = await getAllPosts(lang);
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, POSTS_PER_PAGE);

// Pinned Posts
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

// Notes
const allNotes = await getAllNotes(lang);
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_HOME_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: t.home.title }}>
	<section>
		<h1 class="title mb-4">{t.home.heroName}</h1>
		<p class="mb-4">{t.home.heroBio}</p>
		<SocialList />
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">{t.home.pinnedPosts}</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl">
			<a href={getLocalizedUrl("posts", lang)}>{t.home.posts}</a>
		</h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href={getLocalizedUrl("notes", lang)}>{t.home.notes}</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>
