---
import type { GetStaticPaths } from "astro";
import { defaultLang, type Lang, languageCodes, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (() => {
	const nonDefaultLangs = languageCodes.filter((lang) => lang !== defaultLang);
	return nonDefaultLangs.map((lang) => ({
		params: { lang },
		props: { lang },
	}));
}) satisfies GetStaticPaths;

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const meta = {
	description: t.error.description,
	title: t.error.title,
};
---

<PageLayout lang={lang} meta={meta}>
	<h1 class="title mb-12">{t.error.heading}</h1>
	<p class="mb-8">{t.error.message}</p>
</PageLayout>
