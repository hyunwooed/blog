---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllNotes } from "@/data/post";
import { defaultLang, getLocalizedUrl, languageCodes, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";
import { NOTES_PER_PAGE } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const nonDefaultLangs = languageCodes.filter((lang) => lang !== defaultLang);
	const paths = [];

	for (const lang of nonDefaultLangs) {
		const allNotes = await getAllNotes(lang);
		const allNotesByDate = allNotes.sort(collectionDateSort);
		const paginated = paginate(allNotesByDate, {
			pageSize: NOTES_PER_PAGE,
			params: { lang },
			props: { lang },
		});
		paths.push(...paginated);
	}

	return paths;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, lang } = Astro.props;
const t = useTranslations(lang);

const meta = {
	description: t.notes.description,
	title: t.notes.title,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: t.pagination.previousNotes,
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: t.pagination.nextNotes,
			url: page.url.next,
		},
	}),
};
---

<PageLayout lang={lang} meta={meta}>
	<div class="mb-12 flex items-center gap-3">
		<h1 class="title">{t.notes.title}</h1>
		<a class="text-accent" href={getLocalizedUrl("notes/rss.xml", lang)} target="_blank">
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
		</a>
	</div>
	<ul class="space-y-8" role="list">
		{
			page.data.map((note) => (
				<li>
					<Note note={note} as="h2" isPreview />
				</li>
			))
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
