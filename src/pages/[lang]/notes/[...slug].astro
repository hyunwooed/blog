---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import Note from "@/components/note/Note.astro";
import { getAllNotes } from "@/data/post";
import { defaultLang, getCleanSlug, type Lang, languageCodes, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const nonDefaultLangs = languageCodes.filter((lang) => lang !== defaultLang);
	const paths = [];

	for (const lang of nonDefaultLangs) {
		const allNotes = await getAllNotes(lang);
		for (const note of allNotes) {
			paths.push({
				params: { lang, slug: getCleanSlug(note.id) },
				props: { note, lang },
			});
		}
	}

	return paths;
}) satisfies GetStaticPaths;

interface Props {
	note: CollectionEntry<"note">;
	lang: Lang;
}

const { note, lang } = Astro.props as Props;
const t = useTranslations(Astro.url);

const meta = {
	description:
		note.data.description ??
		`${t.notes.title}: ${note.data.publishDate.toLocaleDateString(t.locale)}`,
	title: note.data.title,
};
---

<PageLayout lang={lang} meta={meta}>
	<Note as="h1" note={note} />
</PageLayout>
