---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllNotes } from "@/data/post";
import { defaultLang, getLocalizedUrl, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";
import { NOTES_PER_PAGE } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allNotes = await getAllNotes(defaultLang);
	const allNotesByDate = allNotes.sort(collectionDateSort);
	return paginate(allNotesByDate, { pageSize: NOTES_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
}

const { page } = Astro.props;
const t = useTranslations(Astro.url);

const meta = {
	description: t.notes.description,
	title: t.notes.title,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: t.pagination.previousNotes,
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: t.pagination.nextNotes,
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<div class="mb-12 flex items-center gap-3">
		<h1 class="title">{t.notes.title}</h1>
		<a class="text-accent" href={getLocalizedUrl("notes/rss.xml", defaultLang)} target="_blank">
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
		</a>
	</div>
	<ul class="space-y-8" role="list">
		{
			page.data.map((note) => (
				<li>
					<Note note={note} as="h2" isPreview />
				</li>
			))
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
