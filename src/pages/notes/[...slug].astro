---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Note from "@/components/note/Note.astro";
import { getAllNotes } from "@/data/post";
import { defaultLang, getCleanSlug, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const allNotes = await getAllNotes(defaultLang);
	return allNotes.map((note) => ({
		params: { slug: getCleanSlug(note.id) },
		props: { note },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note } = Astro.props;
const t = useTranslations(Astro.url);

const meta = {
	description:
		note.data.description ??
		`${t.notes.title}: ${note.data.publishDate.toLocaleDateString(t.locale)}`,
	title: note.data.title,
};
---

<PageLayout meta={meta}>
	<Note as="h1" note={note} />
</PageLayout>
