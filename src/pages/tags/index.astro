---
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import { defaultLang, getLocalizedUrl, useTranslations } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

const t = useTranslations(Astro.url);
const allPosts = await getAllPosts(defaultLang);
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: t.tags.description,
	title: t.tags.allTags,
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">{t.tags.title}</h1>
	<ul class="space-y-4">
		{
			allTags.map(([tag, val]) => (
				<li class="flex items-center gap-x-2">
					<a
						class="cactus-link inline-block"
						href={getLocalizedUrl(`tags/${tag}`, defaultLang)}
						title={`${t.tags.viewPostsWithTag}: ${tag}`}
					>
						&#35;{tag}
					</a>
					<span class="inline-block">
						- {val} {val > 1 ? t.tags.posts : t.tags.post}
					</span>
				</li>
			))
		}
	</ul>
</PageLayout>
