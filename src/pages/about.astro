---
import { getEntry, render } from "astro:content";
import { defaultLang } from "@/i18n";
import PageLayout from "@/layouts/Base.astro";

const aboutEntry = await getEntry("about", defaultLang);
if (!aboutEntry) throw new Error(`About entry not found for ${defaultLang}`);

const { Content } = await render(aboutEntry);
---

<PageLayout meta={{ title: aboutEntry.data.title, description: aboutEntry.data.description }}>
	<h1 class="title mb-12">{aboutEntry.data.title}</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<Content />
	</div>
</PageLayout>
